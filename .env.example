# Environment Variables Example
# .env 파일로 복사하여 사용하세요: cp .env.example .env

# Telegram Bot Configuration
# https://core.telegram.org/bots#6-botfather 에서 봇 생성
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Email Configuration (Gmail 예시)
# Gmail 앱 비밀번호: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
RECIPIENT_EMAIL=recipient@example.com

# Camera Configuration
RTSP_URL=rtsp://username:password@camera_ip:554/stream

# Model Configuration
MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/vision_system.log
